@page
@model AboutModel
@{
    ViewData["Title"] = "About & Contact";
}

<div class="container py-4" style="max-width: 860px;">
    <div class="tracker-shell p-4 p-md-5">
        <div class="hero-banner p-4 mb-4">
            <span class="badge rounded-pill bg-warning text-dark fw-semibold mb-2">About This App</span>
            <h1 class="h2 fw-bold mb-1">About Beshe Family Expense Tracker</h1>
            <p class="mb-0 text-white-50">Built by Avuya Beshe for family, kids, and friends</p>
        </div>

        <div class="card modern-card mb-4">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-2 section-heading" style="color: #312e81;">Why I Built This</h5>
                <p class="text-muted mb-3">
                    Welcome to the Beshe family expense tracker! I built this space so anyone—family, kids, or friends—can safely and easily keep track of snacks, treats, school items, rides, and everyday spending in Rands (R).
                </p>

                <div class="row g-3 mt-1">
                    <div class="col-md-4">
                        <div class="p-3 rounded-3 border h-100">
                            <div class="fw-bold mb-1">1. Log in Seconds</div>
                            <small class="text-muted">Pick who spent it, enter the item and Rand amount, and tap a category chip.</small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 rounded-3 border h-100">
                            <div class="fw-bold mb-1">2. Track Goals</div>
                            <small class="text-muted">See how close we are to family holiday funds, games, and weekend treats.</small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 rounded-3 border h-100">
                            <div class="fw-bold mb-1">3. Visual Insights</div>
                            <small class="text-muted">Check charts on the Analytics page to spot top categories and daily averages.</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card modern-card">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-2 section-heading" style="color: #1e293b;">Need Help or Spotted an Issue?</h5>
                <p class="text-muted mb-3">
                    If anything looks weird, a button isn't working, or you want a new feature added for the family, reach out to me directly anytime:
                </p>

                <div class="d-flex flex-column flex-sm-row gap-3">
                    <a href="tel:0765620981" class="btn btn-pop px-4 py-2">
                        📞 Call / WhatsApp: 0765620981
                    </a>
                    <a href="mailto:aobeshe@gmail.com" class="btn btn-outline-primary px-4 py-2 fw-semibold" style="border-radius: 10px;">
                        ✉️ Email: aobeshe@gmail.com
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>