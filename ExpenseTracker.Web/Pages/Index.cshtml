@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<style>
    .quick-chip {
        border: 1px solid #c7d2fe;
        background: #eef2ff;
        color: #3730a3;
        font-size: 0.78rem;
        font-weight: 600;
        border-radius: 999px;
        padding: 0.25rem 0.7rem;
        cursor: pointer;
        transition: all 0.15s ease;
    }

        .quick-chip:hover,
        .who-chip.active {
            background: linear-gradient(90deg, #4f46e5, #ec4899);
            color: #ffffff;
            border-color: transparent;
        }

    body.dark-mode .quick-chip:not(.active) {
        background: rgba(99, 102, 241, 0.2);
        color: #c7d2fe;
        border-color: rgba(129, 140, 248, 0.35);
    }

    .top-control-btn {
        background: rgba(255, 255, 255, 0.18);
        border: 1px solid rgba(255, 255, 255, 0.35);
        color: #ffffff;
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 600;
        padding: 0.3rem 0.8rem;
        text-decoration: none;
        transition: background 0.15s ease;
    }

        .top-control-btn:hover {
            background: rgba(255, 255, 255, 0.3);
            color: #ffffff;
        }

    .who-badge {
        background: #fdf2f8;
        color: #be185d;
        border: 1px solid #fbcfe8;
        font-weight: 600;
        border-radius: 999px;
        padding: 0.25em 0.65em;
        font-size: 0.78rem;
    }

    body.dark-mode .who-badge {
        background: rgba(236, 72, 153, 0.18);
        color: #f9a8d4;
        border-color: rgba(244, 114, 182, 0.35);
    }
</style>

<div class="container py-4" style="max-width: 960px;">
    <div class="tracker-shell p-4 p-md-5">
        <!-- Hero Header + Month Switcher + CSV Export + TOTAL SPENT -->
        <div class="hero-banner p-4 mb-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div class="d-inline-flex align-items-center gap-2 px-2 py-1 rounded-pill" style="background: rgba(0, 0, 0, 0.18);">
                    <a asp-page="./Index" asp-route-SelectedMonth="@Model.PreviousMonth" asp-route-SelectedCategory="@Model.SelectedCategory"
                       class="top-control-btn py-0 px-2" title="Previous Month">&lt;</a>
                    <span class="small fw-semibold px-1">@Model.ActiveMonthLabel</span>
                    <a asp-page="./Index" asp-route-SelectedMonth="@Model.NextMonth" asp-route-SelectedCategory="@Model.SelectedCategory"
                       class="top-control-btn py-0 px-2" title="Next Month">&gt;</a>
                </div>

                <a asp-page-handler="ExportCsv" asp-route-SelectedMonth="@Model.SelectedMonth" asp-route-SelectedCategory="@Model.SelectedCategory"
                   class="top-control-btn">
                    ⬇ Export CSV
                </a>
            </div>

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <h1 class="h2 fw-bold mb-1">Beshe Family Expense Tracker</h1>
                    <p class="mb-0 text-white-50">Log snacks, rides, treats, and everyday spending in Rands (R)</p>
                </div>
                <div class="total-pill px-4 py-3 text-md-end">
                    <div class="small text-uppercase fw-semibold opacity-75">Total Spent</div>
                    <div class="fs-3 fw-bold" id="TotalSpentCounter" data-target="@Model.TotalSpent.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                        @Model.FormatRand(Model.TotalSpent)
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger border-0 shadow-sm rounded-3" role="alert">
                @Model.ErrorMessage
            </div>
        }

        <!-- Quick Add Expense Form with Family Member Selector -->
        <div class="card modern-card mb-4">
            <div class="card-body p-4">
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
                    <h5 class="fw-bold mb-0 section-heading" style="color: #312e81;">Add an Expense</h5>
                    <div class="d-flex flex-wrap align-items-center gap-1">
                        <span class="small fw-semibold text-secondary me-1">Who?</span>
                        @foreach (var member in Model.FamilyMembers)
                        {
                            <button type="button"
                                    class="quick-chip who-chip @(member == Model.SpentBy ? "active" : "")"
                                    onclick="selectWhoChip(this, '@member')">
                                @member
                            </button>
                        }
                    </div>
                </div>

                <form method="post">
                    <input type="hidden" asp-for="SpentBy" id="SpentByInput" />
                    <input type="hidden" name="SelectedCategory" value="@Model.SelectedCategory" />
                    <input type="hidden" name="SelectedMonth" value="@Model.SelectedMonth" />
                    <input type="hidden" name="ShowAll" value="@Model.ShowAll" />

                    <div class="row g-3">
                        <div class="col-md-5">
                            <label asp-for="Title" class="form-label fw-semibold small text-secondary">What did you get?</label>
                            <input asp-for="Title" class="form-control form-control-lg fs-6" placeholder="e.g., Ice cream or Petrol" />
                        </div>

                        <div class="col-md-3">
                            <label asp-for="Amount" class="form-label fw-semibold small text-secondary">Amount (R)</label>
                            <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control form-control-lg fs-6" placeholder="50.00" />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Category" class="form-label fw-semibold small text-secondary">Category</label>
                            <input asp-for="Category" id="CategoryInput" class="form-control form-control-lg fs-6" placeholder="e.g., Treats, Transport, School" />
                            <div class="d-flex flex-wrap gap-1 mt-2">
                                @foreach (var chip in new[] { "Food", "Transport", "School", "Treats" })
                                {
                                    <button type="button" class="quick-chip" onclick="selectCategoryChip('@chip')">@chip</button>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="mt-3 d-flex justify-content-between align-items-center">
                        <small class="text-muted">Logging as <strong id="LoggingAsLabel">@Model.SpentBy</strong></small>
                        <button type="submit" class="btn btn-pop px-4 py-2">+ Add Expense</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Latest 5 Expenses + View All History Toggle -->
        <div class="card modern-card">
            <div class="card-body p-4">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <h5 class="fw-bold mb-0 section-heading" style="color: #1e293b;">
                            @(Model.ShowAll ? "All Expenses" : "Latest Expenses")
                        </h5>
                        <span class="badge rounded-pill text-bg-light border">
                            Showing @Model.DisplayedExpenses.Count of @Model.TotalMatchingCount
                        </span>
                    </div>

                    <div class="d-flex flex-wrap gap-1">
                        <a asp-page="./Index" asp-route-SelectedCategory="All" asp-route-SelectedMonth="@Model.SelectedMonth" asp-route-ShowAll="@Model.ShowAll"
                           class="btn btn-sm @(Model.SelectedCategory == "All" ? "btn-primary" : "btn-outline-secondary") rounded-pill">
                            All
                        </a>
                        @foreach (var cat in Model.Categories)
                        {
                            <a asp-page="./Index" asp-route-SelectedCategory="@cat" asp-route-SelectedMonth="@Model.SelectedMonth" asp-route-ShowAll="@Model.ShowAll"
                               class="btn btn-sm @(string.Equals(Model.SelectedCategory, cat, StringComparison.OrdinalIgnoreCase) ? "btn-primary" : "btn-outline-secondary") rounded-pill">
                                @cat
                            </a>
                        }
                    </div>
                </div>

                @if (Model.DisplayedExpenses.Count == 0)
                {
                    <div class="text-center py-4">
                        <p class="text-muted mb-1 fw-medium">Nothing logged for @Model.ActiveMonthLabel yet!</p>
                        <small class="text-muted">Add your first item above to see the dashboard light up.</small>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr class="text-muted small text-uppercase">
                                    <th>Who</th>
                                    <th>Item</th>
                                    <th>Category</th>
                                    <th>Date</th>
                                    <th class="text-end">Amount</th>
                                    <th class="text-end" style="width: 65px;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.DisplayedExpenses)
                                {
                                    <tr>
                                        <td><span class="who-badge">@item.SpentBy</span></td>
                                        <td class="fw-semibold text-dark">@item.Title</td>
                                        <td><span class="cat-badge">@item.Category</span></td>
                                        <td class="text-muted small">@item.CreatedAt.ToString("dd MMM yyyy")</td>
                                        <td class="text-end">
                                            <span class="amount-chip">@Model.FormatRand(item.Amount)</span>
                                        </td>
                                        <td class="text-end">
                                            <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="d-inline">
                                                <input type="hidden" name="SelectedCategory" value="@Model.SelectedCategory" />
                                                <input type="hidden" name="SelectedMonth" value="@Model.SelectedMonth" />
                                                <input type="hidden" name="ShowAll" value="@Model.ShowAll" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger border-0" title="Delete expense">✕</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="border-top pt-3 mt-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                        @if (Model.TotalMatchingCount > 5)
                        {
                            <a asp-page="./Index"
                               asp-route-SelectedCategory="@Model.SelectedCategory"
                               asp-route-SelectedMonth="@Model.SelectedMonth"
                               asp-route-ShowAll="@(!Model.ShowAll)"
                               class="btn btn-sm btn-outline-primary rounded-pill fw-semibold">
                                @(Model.ShowAll ? "Show Latest 5 Only" : $"View All History ({Model.TotalMatchingCount} items)")
                            </a>
                        }
                        else
                        {
                            <a asp-page="/Analytics" class="small fw-semibold text-decoration-none" style="color: #6366f1;">
                                View charts &amp; category breakdown →
                            </a>
                        }

                        <div>
                            <span class="fw-semibold text-secondary me-2">Month Total:</span>
                            <span class="fs-5 fw-bold" style="color: #6366f1;">@Model.FormatRand(Model.TotalSpent)</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function formatRandJs(val) {
            const parts = val.toFixed(2).split(".");
            parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, "\u00A0");
            return "R " + parts[0] + "," + parts[1];
        }

        function animateTotalCounter() {
            const el = document.getElementById("TotalSpentCounter");
            if (!el) return;
            const target = parseFloat(el.dataset.target || "0");
            if (isNaN(target) || target <= 0) return;

            const duration = 550;
            const startTime = performance.now();

            function tick(now) {
                const progress = Math.min((now - startTime) / duration, 1);
                const eased = 1 - Math.pow(1 - progress, 3);
                el.textContent = formatRandJs(target * eased);
                if (progress < 1) {
                    requestAnimationFrame(tick);
                } else {
                    el.textContent = formatRandJs(target);
                }
            }

            requestAnimationFrame(tick);
        }

        function selectCategoryChip(categoryName) {
            const input = document.getElementById("CategoryInput");
            if (input) {
                input.value = categoryName;
                input.focus();
            }
        }

        function selectWhoChip(btn, memberName) {
            document.querySelectorAll(".who-chip").forEach(c => c.classList.remove("active"));
            btn.classList.add("active");
            const input = document.getElementById("SpentByInput");
            const label = document.getElementById("LoggingAsLabel");
            if (input) input.value = memberName;
            if (label) label.textContent = memberName;
        }

        document.addEventListener("DOMContentLoaded", animateTotalCounter);
    </script>
}